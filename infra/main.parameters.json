{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "entraTenantId": {
      "value": "${ENTRA_TENANT_ID}"
    },
    "serviceManagementReference": {
      "value": "${ENTRA_SERVICE_MANAGEMENT_REFERENCE=}"
    },
    "webImageName": {
      "value": "${SERVICE_WEB_IMAGE_NAME=}"
    },
    "aiAgentEndpoint": {
      "value": "${AI_AGENT_ENDPOINT=}"
    },
    "aiAgentId": {
      "value": "${AI_AGENT_ID=}"
    },
    "enableObo": {
      "value": "${ENABLE_OBO=false}"
    },
    "aiAgentVersion": {
      "value": "${AI_AGENT_VERSION=}"
    },
    "containerCpu": {
      "value": "${CONTAINER_CPU=0.5}"
    },
    "containerMemory": {
      "value": "${CONTAINER_MEMORY=1Gi}"
    },
    "minReplicas": {
      "value": "${CONTAINER_MIN_REPLICAS=0}"
    },
    "maxReplicas": {
      "value": "${CONTAINER_MAX_REPLICAS=3}"
    },
    "allowedIpRanges": {
      "value": "${INGRESS_ALLOWED_IP_RANGES=[]}"
    },
    "logRetentionDays": {
      "value": "${LOG_RETENTION_DAYS=30}"
    },
    "logDailyQuotaGb": {
      "value": "${LOG_DAILY_QUOTA_GB=-1}"
    },
    "containerRegistrySku": {
      "value": "${CONTAINER_REGISTRY_SKU=Basic}"
    },
    "enableEntraTelemetryAuth": {
      "value": "${ENABLE_ENTRA_TELEMETRY_AUTH=false}"
    },
    "entraAllowedGroupId": {
      "value": "${ENTRA_ALLOWED_GROUP_ID=}"
    },
    "entraAllowLocalhostRedirects": {
      "value": "${ENTRA_ALLOW_LOCALHOST_REDIRECTS=false}"
    },
    "entraGrantSpaAdminConsent": {
      "value": "${ENTRA_GRANT_SPA_ADMIN_CONSENT=false}"
    },
    "defaultTags": {
      "value": {
        "Agente": "${TAG_AGENTE=LeitnerIA}",
        "Entorno": "${TAG_ENTORNO=dev}",
        "Plataforma": "${TAG_PLATAFORMA=Foundry}"
      }
    }
  }
}
