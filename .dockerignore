# Dependencies (exclude ALL node_modules directories)
**/node_modules
node_modules
npm-debug.log

# Build outputs (exclude ALL build directories)
.next
out
build
**/dist
dist
bin
obj
**/bin/
**/obj/
**/build/

# Testing
coverage
.vs

# Misc
.DS_Store
*.pem

# Environment files: never send them to the build context (local or ACR Tasks upload).
# The Dockerfile also deletes them, but excluding them here keeps them out of the uploaded context.
**/.env
**/.env.*
**/*.local

# Hook logs and azd state may contain tenant/client identifiers
.azure

# Tests are not part of the image
backend/WebApp.Api.Tests

# Git
.git
.gitignore
.github

# Docker
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.override.yml

# Dev containers
.devcontainer

# Azure (not needed in container)
.azure
azure.yaml
azure.yaml.json

# Infrastructure (not needed in container)
infra

# Documentation (not needed in container)
README.md
*.md
docs

# IDE and scripts (not needed in container)
.vscode
.idea
scripts

# Hooks (not needed in container)
hooks
