<Project Sdk="MSTest.Sdk/3.10.2">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Use the shared ASP.NET Core framework (also lets NuGet prune framework packages such as
         Microsoft.AspNetCore.DataProtection 10.0.0, flagged by GHSA-9mv3-2cwr-p262). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebApp.Api\WebApp.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- In-memory test server for integration tests (auth, validation, security headers). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
  </ItemGroup>

</Project>
