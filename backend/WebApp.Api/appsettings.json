{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Identity": "Warning",
      "WebApp.Api.Services": "Information"
    }
  },
  "AllowedHosts": "*",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/"
  },
  "AI_AGENT_ENDPOINT": "PLACEHOLDER_SET_VIA_ENV_VAR_OR_AZD_PREPROVISION",
  "AI_AGENT_ID": "PLACEHOLDER_SET_VIA_ENV_VAR_OR_AZD_PREPROVISION",
  "Limits": {
    "MaxRequestBodyMegabytes": 30
  },
  "RateLimiting": {
    "ChatPermitsPerMinute": 20,
    "ApiPermitsPerMinute": 120
  },
  "Uploads": {
    "RetentionHours": 168,
    "CleanupIntervalHours": 6
  }
}
